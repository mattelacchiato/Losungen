<?xml version="1.0" encoding="UTF-8"?>
<strings>
    <string scope="glance" id="GlanceTitleGap">4</string>
    <string scope="glance" id="GlanceMarginX">4</string>
    <!-- 0=XTINY, 1=TINY, 2=SMALL, 3=MEDIUM, 4=LARGE -->
    <string scope="glance" id="GlanceTitleFont">2</string>
    <!-- Main view layout. OverviewVInset = -1 means "auto" (height / 8),
         used by round faces to clear the curved top/bottom edges. -->
    <string id="OverviewMarginX">10</string>
    <string id="OverviewVInset">-1</string>
    <!-- Body font for the main view. Default FONT_XTINY (0) renders cleanly
         everywhere from ~240 px upward. Small-display devices (≤218 px)
         override this to FONT_TINY (1) via resources-bodyfont-tiny so the
         bitmap glyphs don't look ragged. -->
    <string id="OverviewBodyFont">0</string>
</strings>
