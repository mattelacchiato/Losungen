project.manifest = manifest.xml

base.resourcePath = resources

fenix7.resourcePath = $(base.resourcePath);resources-fenix7
fenix7s.resourcePath = $(base.resourcePath);resources-fenix7
fenix7x.resourcePath = $(base.resourcePath);resources-fenix7
fenix7pro.resourcePath = $(base.resourcePath);resources-fenix7
fenix7spro.resourcePath = $(base.resourcePath);resources-fenix7
fenix7xpro.resourcePath = $(base.resourcePath);resources-fenix7
fenix7pronowifi.resourcePath = $(base.resourcePath);resources-fenix7
fenix7xpronowifi.resourcePath = $(base.resourcePath);resources-fenix7

# Venu Sq 2 family: rectangular display, no curved-edge insets, denser glance.
venusq2.resourcePath = $(base.resourcePath);resources-venusq2
venusq2m.resourcePath = $(base.resourcePath);resources-venusq2

# Venu Sq Gen 1 shares the rectangular layout with Venu Sq 2 but uses a
# 36×36 launcher icon instead of the default 40×40.
venusq.resourcePath = $(base.resourcePath);resources-icon-36;resources-venusq2
venusqm.resourcePath = $(base.resourcePath);resources-icon-36;resources-venusq2

# Launcher icon overrides per device. Default 40x40 in resources/ stays
# for fr955, fenix7 family, fenix7pro family, fenix8 solar. Other devices
# get a size-matched icon to avoid SDK upscaling warnings.
venu441mm.resourcePath = $(base.resourcePath);resources-icon-54
vivoactive6.resourcePath = $(base.resourcePath);resources-icon-54
fr165.resourcePath = $(base.resourcePath);resources-icon-54
fr165m.resourcePath = $(base.resourcePath);resources-icon-54
fr57042mm.resourcePath = $(base.resourcePath);resources-icon-54
vivoactive5.resourcePath = $(base.resourcePath);resources-icon-56
approachs50.resourcePath = $(base.resourcePath);resources-icon-56
fenix843mm.resourcePath = $(base.resourcePath);resources-icon-60
fenixe.resourcePath = $(base.resourcePath);resources-icon-60
epix2pro42mm.resourcePath = $(base.resourcePath);resources-icon-60
epix2pro47mm.resourcePath = $(base.resourcePath);resources-icon-60
epix2pro51mm.resourcePath = $(base.resourcePath);resources-icon-60
instinct3amoled45mm.resourcePath = $(base.resourcePath);resources-icon-60
instinct3amoled50mm.resourcePath = $(base.resourcePath);resources-icon-60
fr265.resourcePath = $(base.resourcePath);resources-icon-60
fr265s.resourcePath = $(base.resourcePath);resources-icon-60
epix2.resourcePath = $(base.resourcePath);resources-icon-60
marq2.resourcePath = $(base.resourcePath);resources-icon-60
marq2aviator.resourcePath = $(base.resourcePath);resources-icon-60
approachs7042mm.resourcePath = $(base.resourcePath);resources-icon-60
descentg2.resourcePath = $(base.resourcePath);resources-icon-60
descentmk343mm.resourcePath = $(base.resourcePath);resources-icon-60
d2mach1.resourcePath = $(base.resourcePath);resources-icon-60
descentmk351mm.resourcePath = $(base.resourcePath);resources-icon-60;resources-descentmk351mm
fenix847mm.resourcePath = $(base.resourcePath);resources-icon-65
fenix8pro47mm.resourcePath = $(base.resourcePath);resources-icon-65
venu445mm.resourcePath = $(base.resourcePath);resources-icon-65
venux1.resourcePath = $(base.resourcePath);resources-icon-65;resources-venux1
fr57047mm.resourcePath = $(base.resourcePath);resources-icon-65
fr965.resourcePath = $(base.resourcePath);resources-icon-65
fr970.resourcePath = $(base.resourcePath);resources-icon-65
d2mach2.resourcePath = $(base.resourcePath);resources-icon-65
d2mach2pro.resourcePath = $(base.resourcePath);resources-icon-65
venu3.resourcePath = $(base.resourcePath);resources-icon-70
venu3s.resourcePath = $(base.resourcePath);resources-icon-70
venu2.resourcePath = $(base.resourcePath);resources-icon-70
venu2plus.resourcePath = $(base.resourcePath);resources-icon-70
approachs7047mm.resourcePath = $(base.resourcePath);resources-icon-70;resources-approachs7047mm
d2airx10.resourcePath = $(base.resourcePath);resources-icon-70
venu2s.resourcePath = $(base.resourcePath);resources-icon-61

# CIQ 3.3/3.4 watches added in 2026.2: most use the default 40×40 icon
# (fr245/245m/945/945lte, fenix6 family, enduro, descent mk2 family,
# MARQ Gen 1) and inherit the round layout defaults. Only the smaller
# launcher icons need explicit overrides.
fr55.resourcePath = $(base.resourcePath);resources-icon-35
vivoactive4.resourcePath = $(base.resourcePath);resources-icon-35
vivoactive4s.resourcePath = $(base.resourcePath);resources-icon-30
venu.resourcePath = $(base.resourcePath);resources-icon-60
